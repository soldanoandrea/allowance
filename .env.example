# Allowance - environment for the CLI, the example agents and the demo API.
# `make demo` needs NONE of this: it runs on a throw-away local sandbox.
# For your own vault: copy to .env (git-ignored), fill in, then load it with
#   set -a; . ./.env; set +a      (or: node --env-file=.env ...)
# Never commit keys. Prefer --key-file <path> (chmod 600) to a key in the environment.

# --- Network ---------------------------------------------------------------
ALLOWANCE_RPC_URL=https://test.rpc.fastnear.com
ALLOWANCE_VAULT=vault.your-account.testnet

# --- Agent (function-call key on the vault: can only call pay / confirm_delivery / ping)
# ALLOWANCE_AGENT_KEY=ed25519:...

# --- Owner commands: approve / deny / kill (full-access key of the owner account)
ALLOWANCE_OWNER=your-account.testnet
# ALLOWANCE_OWNER_KEY=ed25519:...

# --- Paid demo API (demo-api/src/main.ts) -----------------------------------
API_PAYEE=api.your-account.testnet
# Whose receipts to accept: vault accounts and/or contract code hashes (base58 sha256 of allowance.wasm)
ALLOWANCE_VAULTS=vault.your-account.testnet
ALLOWANCE_CODE_HASHES=
ATTACKER_ACCOUNT=attacker.testnet
VERIFY_FINALITY=final
HOST=127.0.0.1
PORT=8402
DEMO_API_URL=http://127.0.0.1:8402

# --- Optional LLM planner (--planner llm), NEAR AI Cloud (OpenAI-compatible) --
# NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1
