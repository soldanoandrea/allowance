# Allowance on NEAR testnet - copy to .env.testnet (git-ignored), fill in,
# then `make demo-testnet` (dry run) and `TESTNET_CONFIRM=yes make demo-testnet`.
# Every account must already exist; the scripts never create accounts and
# never write keys. Step-by-step: docs/TESTNET.md.
#
# Keys: each *_KEY_FILE can be replaced by the key itself in TESTNET_OWNER_KEY /
# TESTNET_VAULT_KEY / TESTNET_AGENT_KEY, injected at run time by your password
# manager (e.g. 1Password: `op run --env-file=.env.testnet -- make demo-testnet`
# with op://... references), so no key file is ever written to disk.

TESTNET_RPC_URL=https://test.rpc.fastnear.com

# Owner: manages the vault (deposit, add_agent, approve, kill). Full-access key file (near-cli JSON).
TESTNET_OWNER_ID=you.testnet
TESTNET_OWNER_KEY_FILE=/Users/you/.near-credentials/testnet/you.testnet.json

# The vault account (create it first, e.g. vault.you.testnet with ~5 NEAR). Its
# full-access key is only used to deploy the contract.
TESTNET_VAULT_ID=vault.you.testnet
TESTNET_VAULT_KEY_FILE=/Users/you/.near-credentials/testnet/vault.you.testnet.json

# The paid API's account (receives the payments; no key needed by the scripts).
TESTNET_PAYEE_ID=api.you.testnet

# The agent's key (node scripts/testnet/agent-key.ts vault.you.testnet > <file outside the repo>).
TESTNET_AGENT_KEY_FILE=/Users/you/.near-credentials/testnet/allowance-agent.json

# Optional
# TESTNET_APPROVER_ID=friend.testnet
TESTNET_DEPOSIT_NEAR=2
TESTNET_PER_TX_CAP=0.5
TESTNET_BUDGET=1
TESTNET_BUDGET_PERIOD=1d
TESTNET_APPROVAL_THRESHOLD=0.25
# TESTNET_ARCHIVAL_RPC_URL=
# TESTNET_DENYLIST=known-scam.testnet
TESTNET_API_PORT=8402
# TESTNET_AUTO_APPROVE=1   # the script approves pending requests itself (otherwise: approve by hand with the CLI)
# TESTNET_CONFIRM=yes      # actually send transactions (default: dry run)
